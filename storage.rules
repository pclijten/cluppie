rules_version = '2';
/* Cluppie — Storage-regels. Getest in de emulator: npm run test:storage (tests/storage-rules.test.mjs). Bestanden staan onder clubs/{clubId}/…;
   toegang volgt het clublidmaatschap in Firestore. */
service firebase.storage {
  match /b/{bucket}/o {
    function ingelogd() { return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function club(c) { return firestore.get(/databases/(default)/documents/clubs/$(c)).data; }
    function lid(c) {
      return ingelogd() && firestore.exists(/databases/(default)/documents/clubs/$(c))
        && (club(c).get('leden', {}).get(request.auth.uid, false) == true
            || club(c).get('admins', {}).get(request.auth.uid, false) == true);
    }
    /* [20261103] trainingscoördinator: alleen lezen van trainingen (pdf en plaatjes) en video's */
    function trainco(c) {
      return ingelogd() && firestore.exists(/databases/(default)/documents/clubs/$(c))
        && club(c).get('trainingscoordinatoren', {}).get(request.auth.uid, false) == true;
    }
    function beheerder(c) {
      return ingelogd() && firestore.exists(/databases/(default)/documents/clubs/$(c))
        && club(c).get('admins', {}).get(request.auth.uid, false) == true;
    }

    match /clubs/{clubId}/videos/{f} {
      allow read: if lid(clubId) || trainco(clubId);
      allow write: if lid(clubId) && request.resource.size < 300 * 1024 * 1024 && request.resource.contentType.matches('video/.*');
      // [20261127] voorbeeldbeeld (poster) dat bij het uploaden in de browser wordt gemaakt
      allow write: if lid(clubId) && request.resource.size < 2 * 1024 * 1024 && request.resource.contentType == 'image/jpeg';
      allow delete: if beheerder(clubId);
    }
    match /clubs/{clubId}/trainingvideos/{t}/{f} {
      allow read: if lid(clubId) || trainco(clubId);
      allow write: if lid(clubId) && request.resource.size < 300 * 1024 * 1024 && request.resource.contentType.matches('video/.*');
      allow delete: if lid(clubId);
    }
    match /clubs/{clubId}/documenten/{f} {
      allow read: if lid(clubId);
      allow write: if beheerder(clubId) && request.resource.size < 50 * 1024 * 1024 && request.resource.contentType == 'application/pdf';
      allow delete: if beheerder(clubId);
    }
    match /clubs/{clubId}/trainingen/{m}/{f} {
      allow read: if lid(clubId) || trainco(clubId);
      /* [20261116d] alleen wat de app hier neerzet: de PDF van een training en de plaatjes eruit */
      allow write: if lid(clubId) && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/png|image/jpeg');
      allow delete: if lid(clubId);
    }
    /* [20261120a] Veldkaart: foto van de veldindeling bij een melding. De app verkleint hem tot een JPEG
       (meestal 100 tot 300 kB). Lezen: de afzender en de clubbeheerder. */
    match /clubs/{clubId}/veldfotos/{u}/{f} {
      allow read: if ingelogd() && (request.auth.uid == u || beheerder(clubId));
      allow create: if lid(clubId) && request.auth.uid == u
        && request.resource.size < 3 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if beheerder(clubId);
    }
    /* alles anders (oude paden zonder club) is dicht */
    match /{ander=**} { allow read, write: if false; }
  }
}
