rules_version = '2';
/* Cluppie — Firestore-regels (AVG-aangescherpt: leesrechten per club, geen open collecties) voor het datamodel van de app (teams/{id} met
   club + leden{uid}; clubs/{id} met admins, leden, bouwCoordinatoren).
   Testen: `npm run test:rules` (start de emulator en draait tests/rules.test.mjs). */
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- basis ---------- */
    function ingelogd() { return request.auth != null; }
    function anoniem() { return ingelogd() && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function echt() { return ingelogd() && !anoniem(); }
    function uid() { return request.auth.uid; }
    function wijzigt(sleutels) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(sleutels); }
    /* [20261125w] sportprofiel: de sporten die de app kent (public/js/sporten.js). Ontbreekt het veld, dan is het voetbal. */
    function geldigeSport(d) { return d.get('sport', 'voetbal') in ['voetbal']; }
    function sportGelijk() { return request.resource.data.get('sport', null) == resource.data.get('sport', null); }

    /* ---------- platform ---------- */
    function platformDoc() { return get(/databases/$(database)/documents/platform/instellingen).data; }
    function isPlatform() {
      return echt() && request.auth.token.email_verified == true && (
        (exists(/databases/$(database)/documents/platform/instellingen)
          && platformDoc().get('beheerders', []).hasAny([request.auth.token.email]))
        || request.auth.token.email == 'pclijten@gmail.com');
    }

    /* [20261020a] ondersteuningsmodus: de eindbaas werkt tijdelijk als clubbeheerder in precies één club.
       Het document ondersteuning/{uid} wordt alleen door de Cloud Function startOndersteuning gemaakt
       (die controleert dat de club het niet heeft uitgezet en de start vastlegt in het toegangslog)
       en verloopt vanzelf (veld tot). Zonder die modus heeft de eindbaas geen toegang tot spelers en teamgegevens. */
    function ondersteuningActief(c) {
      return isPlatform() && c != null
        && exists(/databases/$(database)/documents/ondersteuning/$(request.auth.uid))
        && get(/databases/$(database)/documents/ondersteuning/$(request.auth.uid)).data.clubId == c
        && get(/databases/$(database)/documents/ondersteuning/$(request.auth.uid)).data.tot > request.time;
    }

    /* ---------- club-rollen ---------- */
    function club(c) { return get(/databases/$(database)/documents/clubs/$(c)).data; }
    function clubBestaat(c) { return c != null && exists(/databases/$(database)/documents/clubs/$(c)); }
    function isClubAdmin(c) { return echt() && clubBestaat(c) && (club(c).get('admins', {}).get(uid(), false) == true || ondersteuningActief(c)); }
    function isClubLid(c) { return echt() && clubBestaat(c) && (club(c).get('leden', {}).get(uid(), false) == true || isClubAdmin(c)); }
    function isCoordinatorVanBouw(c, bouw) {
      return echt() && clubBestaat(c) && club(c).get('bouwCoordinatoren', {}).get(bouw, {}).get(uid(), false) == true;
    }

    /* hoofd jeugdopleiding (club-breed seizoensplan): veld clubs/{id}.hoofdJeugd.{uid} = true; alleen de clubadmin zet dat */
    /* [20261103] trainingscoördinator: alleen lezen, en alleen teams, trainingen en video's van de club
       (nooit spelers, wedstrijden, berichten of documenten). De rechtenbron is clubs/{id}.trainingscoordinatoren.<uid>;
       alleen een clubbeheerder zet die, via de Cloud Function beoordeelAanvraag of rechtstreeks in het clubdocument. */
    function isTraincoVanClub(c) { return echt() && clubBestaat(c) && club(c).get('trainingscoordinatoren', {}).get(uid(), false) == true; }
    /* [20261124v] Veldplanner: de eindbaas zet hem per club aan (clubs/{id}.platformModules.veldplanner) */
    function veldplannerAan(c) { return club(c).get('platformModules', {}).get('veldplanner', false) == true; }
    /* [20261125x] Activiteiten (organisatiecomité): de eindbaas zet het per club aan (clubs/{id}.platformModules.activiteiten).
       Comité = clubleden die de clubbeheerder in activiteiten/{id}.comiteUids zet. */
    function activiteitenAan(c) { return clubBestaat(c) && club(c).get('platformModules', {}).get('activiteiten', false) == true; }
    function activiteit(c, a) { return get(/databases/$(database)/documents/clubs/$(c)/activiteiten/$(a)).data; }
    function isComite(c, a) { return isClubLid(c) && exists(/databases/$(database)/documents/clubs/$(c)/activiteiten/$(a)) && uid() in activiteit(c, a).get('comiteUids', []); }
    function magActiviteit(c, a) { return activiteitenAan(c) && (isClubAdmin(c) || isComite(c, a)); }
    function isVeldplanner(c) { return isClubAdmin(c) || isTraincoVanClub(c); }
    function isHoofdJeugd(c) { return echt() && clubBestaat(c) && club(c).get('hoofdJeugd', {}).get(uid(), false) == true; }
    function isJeugdPlanner(c) { return isClubAdmin(c) || isHoofdJeugd(c); }
    function isSpeelstijlDeelnemer(c) { return isJeugdPlanner(c) || isCoordinatorVanBouw(c, 'onder') || isCoordinatorVanBouw(c, 'midden') || isCoordinatorVanBouw(c, 'boven'); }

    /* ---------- team-rollen ---------- */
    function team(t) { return get(/databases/$(database)/documents/teams/$(t)).data; }
    function teamBestaat(t) { return t != null && exists(/databases/$(database)/documents/teams/$(t)); }
    function isTeamLid(t) { return echt() && teamBestaat(t) && team(t).get('leden', {}).get(uid(), false) == true; }
    /* volledige coach = teamlid dat geen 'assistent' is (ontbrekende rol = coach, oude data) */
    function isVolCoach(t) { return echt() && teamBestaat(t) && volCoachData(team(t)); }
    function teamClub(t) { return team(t).get('club', null); }
    /* [20261115e] Teamrechten, zuinig opgezet: het team- en clubdocument worden één keer opgehaald en als
       gegevens doorgegeven. De eerdere vorm (elke hulpfunctie haalt zelf op) liep bij een clublid dat spelers
       van een ander team las tegen de limiet van 1000 evaluaties per verzoek aan, en dat geeft een weigering.
       - volle coach: lid van het team en geen 'assistent';
       - sturende rol voor dit team: clubadmin, coördinator van de bouw van het team, of gekoppelde coach van
         een eigen bouw waar het team in zit (clubs/{id}.eigenBouwToegang.{teamId}.{uid}; alleen de clubadmin
         schrijft het clubdocument), of de eindbaas in de ondersteuningsmodus. */
    function volCoachData(tm) {
      return tm.get('leden', {}).get(uid(), false) == true && tm.get('rollen', {}).get(uid(), 'coach') != 'assistent';
    }
    function bouwSturenDoc(d, bouw, t) {
      return d.get('admins', {}).get(uid(), false) == true
        || d.get('bouwCoordinatoren', {}).get(bouw, {}).get(uid(), false) == true
        || d.get('eigenBouwToegang', {}).get(t, {}).get(uid(), false) == true;
    }
    function bouwSturenData(t, tm) {
      let c = tm.get('club', null);
      return c != null && clubBestaat(c) && (bouwSturenDoc(club(c), tm.get('bouw', '_'), t) || ondersteuningActief(c));
    }
    function magBouwSturen(t) { return echt() && teamBestaat(t) && bouwSturenData(t, team(t)); }
    /* schrijfrechten per team: volle coach of een sturende rol */
    function magSchrijven(t) { return echt() && teamBestaat(t) && (volCoachData(team(t)) || bouwSturenData(t, team(t))); }
    /* sturende rol ergens in de club: clubadmin, hoofd jeugdopleiding, een bouwcoördinator of een gekoppelde
       coach van een eigen bouw. Zij lezen de spelerslijsten en uitleningen van de hele club (uitlenen, bouwoverzicht). */
    function sturendDoc(d) {
      return d.get('admins', {}).get(uid(), false) == true
        || d.get('hoofdJeugd', {}).get(uid(), false) == true
        || d.get('bouwCoordinatoren', {}).get('onder', {}).get(uid(), false) == true
        || d.get('bouwCoordinatoren', {}).get('midden', {}).get(uid(), false) == true
        || d.get('bouwCoordinatoren', {}).get('boven', {}).get(uid(), false) == true
        || uid() in d.get('eigenBouwCoaches', []);
    }
    function isSturendInClub(c) { return echt() && clubBestaat(c) && (sturendDoc(club(c)) || ondersteuningActief(c)); }
    /* [20261115d] Wat een coach op zijn eigen teamdocument NIET mag: club, werkwijze, rollen, de bouw los van de
       categorie en de Sportlink-koppeling wijzigen, iemand aan leden toevoegen (alleen verwijderen; toevoegen loopt via de
       Cloud Functions met log) of het koppelvoorstel naar een andere club laten wijzen. */
    function coachWijzigtTeamVeilig() {
      let k = request.resource.data.diff(resource.data).affectedKeys();
      let l = request.resource.data.get('leden', {}).diff(resource.data.get('leden', {}));
      return !k.hasAny(['club', 'werkwijzeVrij', 'rollen', 'bouwHandmatig', 'sportlinkTeamcode', 'sportlinkNaam'])
        /* de bouw volgt de categorie (teaminstellingen), behalve als de club het team met de hand heeft ingedeeld */
        && (!k.hasAny(['bouw']) || (k.hasAny(['categorie']) && resource.data.get('bouwHandmatig', false) != true
            && request.resource.data.get('bouw', null) in [null, 'onder', 'midden', 'boven']))
        && l.addedKeys().size() == 0 && l.changedKeys().size() == 0
        && request.resource.data.get('koppelVoorstel', {}).get('clubId', null) == resource.data.get('koppelVoorstel', {}).get('clubId', null);
    }

    /* ======================= platform ======================= */
    match /platform/{doc} {
      allow read: if echt();
      allow write: if false;            /* alleen handmatig in de console (zie PORTEREN.md) */
    }
    /* [20261113d] trainingsbibliotheek: beheerlaag van de platformbeheerder. Iedereen die is ingelogd
       leest (de planner draait in de browser), alleen de platformbeheerder schrijft. */
    match /platform/bibliotheek {
      allow write: if isPlatform();
    }
    match /platform/bibliotheek/vormen/{vormId} {
      allow read: if echt();
      allow write: if isPlatform();
    }
    /* [20261113d] bibliotheekwijziging doorvoeren: de platformbeheerder leest trainingen (club en losse
       trainers) en werkt alleen de oefeningen bij. Andere velden blijven buiten bereik. */
    match /{pad=**}/trainingen/{trainingId} {
      allow read: if isPlatform();
      allow update: if isPlatform()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['oefeningen', 'vormIds', 'bibliotheekBijgewerktMs']);
    }

    /* ======================= privé-rondebeoordelingen ======================= */
    /* [20261114a] Volledige beoordelingen die bij een evaluatieronde van de club horen (winter, lente),
       gepoort uit ASV'33 PR #60. Top-level i.p.v. onder teams/{id}, zodat de teamregel er niet bij kan:
       andere trainers van het team lezen ze NIET. Wie wel leest staat in het document (zichtbaarVoor:
       schrijver, clubbeheerders, hoofd jeugd, coördinatoren van de bouw), vastgelegd bij opslaan.
       De app vraagt altijd op met zichtbaarVoor array-contains <eigen uid>. */
    /* [20261115e] de lezerslijst komt van de app; de rules eisen dat er alleen de schrijver en sturende rollen
       van de club in staan (clubadmins, hoofd jeugd, bouwcoördinatoren, gekoppelde coaches van een eigen bouw) */
    function priveLezersGeldig(lijst, c) {
      let d = club(c);
      return lijst.hasOnly([uid()]
        .concat(d.get('admins', {}).keys()).concat(d.get('hoofdJeugd', {}).keys())
        .concat(d.get('bouwCoordinatoren', {}).get('onder', {}).keys())
        .concat(d.get('bouwCoordinatoren', {}).get('midden', {}).keys())
        .concat(d.get('bouwCoordinatoren', {}).get('boven', {}).keys())
        .concat(d.get('eigenBouwCoaches', [])));
    }
    match /beoordelingenPrive/{beoordelingId} {
      allow read: if echt() && uid() in resource.data.get('zichtbaarVoor', []);
      allow create: if echt()
        && request.resource.data.teamId is string
        && magSchrijven(request.resource.data.teamId)
        && request.resource.data.club == teamClub(request.resource.data.teamId)
        && request.resource.data.door.uid == uid()
        && request.resource.data.zichtbaarVoor is list
        && uid() in request.resource.data.zichtbaarVoor
        && priveLezersGeldig(request.resource.data.zichtbaarVoor, request.resource.data.club);
      allow update: if echt()
        && resource.data.door.uid == uid()
        && request.resource.data.door.uid == uid()
        && request.resource.data.teamId == resource.data.teamId
        && request.resource.data.club == resource.data.club
        && request.resource.data.zichtbaarVoor is list
        && uid() in request.resource.data.zichtbaarVoor
        && priveLezersGeldig(request.resource.data.zichtbaarVoor, request.resource.data.club);
      allow delete: if echt() && resource.data.door.uid == uid();
    }

    /* ======================= clubs ======================= */
    /* KNVB-speeldagen per district en seizoen (id "2026-27_zuid1"): elke ingelogde gebruiker leest,
       alleen de platformbeheerder schrijft. Clubs krijgen hun kalender hier automatisch uit. */
    match /kalenders/{id} {
      allow read: if request.auth != null;
      allow write: if isPlatform();
    }
    /* [20261012h] clubgids: openbare clubgegevens (naam, teamnamen, sportpark, adres) voor het kiezen
       van een tegenstander. Gevuld door de Sportlink-sync (Admin SDK); de app leest alleen. */
    match /clubgids/{code} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /clubs/{clubId} {
      /* lezen: alleen leden van de club (aansluiten loopt via de Cloud Function sluitAan).
         De twee extra voorwaarden dekken de queries admins.<uid>==true en eigenBouwCoaches. */
      allow read: if isPlatform()
        || (echt() && (resource.data.get('leden', {}).get(uid(), false) == true
                       || resource.data.get('admins', {}).get(uid(), false) == true
                       || uid() in resource.data.get('eigenBouwCoaches', [])
                       || resource.data.get('trainingscoordinatoren', {}).get(uid(), false) == true
                       /* [20261115d] bouwcoördinator die (nog) geen clublid is */
                       || resource.data.get('bouwCoordinatoren', {}).get('onder', {}).get(uid(), false) == true
                       || resource.data.get('bouwCoordinatoren', {}).get('midden', {}).get(uid(), false) == true
                       || resource.data.get('bouwCoordinatoren', {}).get('boven', {}).get(uid(), false) == true));
      /* aanmaken: alleen platformbeheerder (zoals de client-gating), maker is zelf admin en lid */
      allow create: if isPlatform()
        && request.resource.data.admins.get(uid(), false) == true
        && request.resource.data.leden.get(uid(), false) == true
        && geldigeSport(request.resource.data);
      /* clubadmin of platformbeheerder: alles */
      allow update: if (isPlatform() && geldigeSport(request.resource.data))
        /* clubadmin mag alles behalve de schakelaars van de eindbaas (platformModules) en de sport [20261125w] */
        || (isClubAdmin(clubId)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['platformModules', 'sport']))
        /* teamaanmaker registreert een nieuw team bij de club: alleen toevoegen, niets weghalen [20261115d] */
        || (echt() && isClubLid(clubId) && wijzigt(['teams'])
            && request.resource.data.get('teams', {}).diff(resource.data.get('teams', {})).removedKeys().size() == 0
            && request.resource.data.get('teams', {}).diff(resource.data.get('teams', {})).changedKeys().size() == 0);
      allow delete: if isClubAdmin(clubId) || isPlatform();

      /* uitleningen [20261115d/e]: lezen door de twee betrokken teams en de sturende rollen van de club (de
         snapshot bevat leerpunten). Aanmaken alleen door een sturende rol (clubadmin,
         coördinator of gekoppelde coach van de bouw) van één van beide teams, en beide teams horen bij deze club.
         Bijwerken en terugzetten: ook de coaches van de twee betrokken teams; de teams en de speler liggen vast. */
      match /uitleningen/{id} {
        allow read: if isSturendInClub(clubId)
          || magSchrijven(resource.data.vanTeam) || magSchrijven(resource.data.naarTeam);
        allow create: if echt()
          && request.resource.data.vanTeam is string && request.resource.data.naarTeam is string
          && teamBestaat(request.resource.data.vanTeam) && teamClub(request.resource.data.vanTeam) == clubId
          && teamBestaat(request.resource.data.naarTeam) && teamClub(request.resource.data.naarTeam) == clubId
          && (magBouwSturen(request.resource.data.vanTeam) || magBouwSturen(request.resource.data.naarTeam));
        allow update: if echt()
          && (magSchrijven(resource.data.vanTeam) || magSchrijven(resource.data.naarTeam))
          && request.resource.data.vanTeam == resource.data.vanTeam
          && request.resource.data.naarTeam == resource.data.naarTeam
          && request.resource.data.spelerId == resource.data.spelerId;
        allow delete: if echt() && (isClubAdmin(clubId) || magSchrijven(resource.data.vanTeam) || magSchrijven(resource.data.naarTeam));
      }
      match /kalender/{id} {
        allow read: if isClubLid(clubId);
        allow write: if isClubAdmin(clubId);
      }
      /* [20261120a] Veldkaart (gepoort uit ASV'33): sportparken (het eigen park en die van tegenstanders) met
         velden en plekken. Lezen: clubleden. Schrijven: alleen de clubbeheerder (de eindbaas alleen in
         ondersteuningsmodus, via isClubAdmin). Er staan geen spelersgegevens in. */
      match /sportparken/{parkId} {
        allow read: if isClubLid(clubId);
        allow write: if isClubAdmin(clubId);
      }
      /* [20261124v] Veldplanner (release 1, nog niets naar de teams): roosters in concept en de instellingen
         (kleedkamers, eigen vakken per veld, licht). Clubbeheer en de trainingscoördinator; schrijven alleen als
         de eindbaas de Veldplanner voor deze club heeft aangezet. Er staan geen spelersgegevens in. */
      match /veldroosters/{roosterId} {
        allow read: if isVeldplanner(clubId);
        allow create, update: if isVeldplanner(clubId) && veldplannerAan(clubId)
          && request.resource.data.blokken is list && request.resource.data.blokken.size() <= 400;
        allow delete: if isVeldplanner(clubId) && veldplannerAan(clubId);
      }
      /* [20261125x] Activiteiten. Geen spelersgegevens: namen van comitéleden (volwassenen) en een begroting.
         - lezen: clubbeheer, of een comitélid van deze activiteit;
         - aanmaken en verwijderen: clubbeheer (met de schakelaar aan);
         - wijzigen: clubbeheer, of het comité; alleen clubbeheer bepaalt wie in het comité zit (comiteUids). */
      match /activiteiten/{actId} {
        allow read: if isClubAdmin(clubId) || (isClubLid(clubId) && uid() in resource.data.get('comiteUids', []));
        allow create: if isClubAdmin(clubId) && activiteitenAan(clubId)
          && request.resource.data.naam is string && request.resource.data.naam.size() > 0 && request.resource.data.naam.size() <= 120
          && request.resource.data.get('comiteUids', []) is list && request.resource.data.get('comiteUids', []).size() <= 40;
        allow update: if activiteitenAan(clubId)
          && request.resource.data.naam is string && request.resource.data.naam.size() > 0 && request.resource.data.naam.size() <= 120
          && request.resource.data.get('comiteUids', []) is list && request.resource.data.get('comiteUids', []).size() <= 40
          && (isClubAdmin(clubId)
              || (isClubLid(clubId) && uid() in resource.data.get('comiteUids', [])
                  && request.resource.data.get('comiteUids', []) == resource.data.get('comiteUids', [])));
        allow delete: if isClubAdmin(clubId) && activiteitenAan(clubId);
      }
      /* wat de teams zien (Planning, Teamkamer via de Cloud Function): naam, datum, tijd, locatie, link. Geen budget of comité. */
      match /activiteitenAgenda/{actId} {
        allow read: if isClubLid(clubId);
        allow write: if magActiviteit(clubId, actId);
      }
      /* eigen draaiboeken van de club (zonder namen of datums) */
      match /activiteitSjablonen/{sjId} {
        allow read: if isClubLid(clubId);
        allow write: if isClubAdmin(clubId) && activiteitenAan(clubId);
      }
      match /veldplanner/{docId} {
        allow read: if isVeldplanner(clubId);
        allow write: if isVeldplanner(clubId) && veldplannerAan(clubId) && docId == 'instellingen';
      }
      /* Een coach meldt dat een veld niet klopt; clubbeheer leest en handelt af. */
      match /veldmeldingen/{meldingId} {
        allow create: if isClubLid(clubId)
          && request.resource.data.door == uid()
          && request.resource.data.status == 'open'
          && request.resource.data.toelichting is string
          && request.resource.data.toelichting.size() <= 500;
        allow read, update, delete: if isClubAdmin(clubId);
      }
      match /afgelastingen/{id} {
        allow read: if isClubLid(clubId);
        allow write: if isClubAdmin(clubId);
      }
      /* club-eigen leerinhoud (content): gepubliceerd = leden, rest = admin */
      match /content/{id} {
        allow read: if isClubLid(clubId);
        allow write: if isClubAdmin(clubId) || isPlatform();
      }
      /* seizoensplan jeugd (club-breed of per bouw). Lezen: clubleden. Plan maken/wijzigen: clubadmin,
         hoofd jeugdopleiding, of de bouwcoördinator voor een eigen bouw (onder/midden/boven, nooit 'club').
         Een bouwcoördinator mag de bouw van een plan niet wijzigen. */
      match /seizoensplannen/{planId} {
        allow read: if isClubLid(clubId) || isClubAdmin(clubId);
        allow create: if isJeugdPlanner(clubId)
          || (echt() && request.resource.data.get('bouw', '_') in ['onder', 'midden', 'boven']
              && isCoordinatorVanBouw(clubId, request.resource.data.get('bouw', '_')));
        allow update: if isJeugdPlanner(clubId)
          || (echt() && resource.data.get('bouw', '_') in ['onder', 'midden', 'boven']
              && isCoordinatorVanBouw(clubId, resource.data.get('bouw', '_'))
              && request.resource.data.get('bouw', '_') == resource.data.get('bouw', '_'));
        allow delete: if isJeugdPlanner(clubId)
          || (echt() && resource.data.get('bouw', '_') in ['onder', 'midden', 'boven']
              && isCoordinatorVanBouw(clubId, resource.data.get('bouw', '_')));
        /* toewijzing per team: schrijven door de planner, of de bouwcoördinator voor een team in zijn bouw */
        match /toewijzingen/{teamId} {
          allow read: if isClubLid(clubId) || isClubAdmin(clubId);
          allow write: if isJeugdPlanner(clubId)
            || (echt() && teamBestaat(teamId) && teamClub(teamId) == clubId
                && isCoordinatorVanBouw(clubId, team(teamId).get('bouw', '_')));
        }
      }

      /* speelstijl van de club [20261019d]. huidig = de vastgelegde stijl (alleen uitkomst): lezen clubleden,
         vastleggen clubadmin of hoofd jeugd. Rondes en antwoorden: alleen de deelnemers (admin, hoofd jeugd,
         bouwcoördinator); iedereen schrijft alleen het eigen antwoord. Maximaal 5 invullers wordt in het scherm bewaakt. */
      match /speelstijl/{id} {
        allow read: if isClubLid(clubId) || isClubAdmin(clubId);
        allow write: if isJeugdPlanner(clubId);
      }
      match /speelstijlRondes/{rondeId} {
        allow read: if isSpeelstijlDeelnemer(clubId);
        allow write: if isJeugdPlanner(clubId);
        match /antwoorden/{antwoordUid} {
          allow read: if isSpeelstijlDeelnemer(clubId);
          allow create, update: if isSpeelstijlDeelnemer(clubId) && antwoordUid == uid();
          allow delete: if isSpeelstijlDeelnemer(clubId) && (antwoordUid == uid() || isJeugdPlanner(clubId));
        }
      }

      /* Sportlink-gegevens: ALLEEN clubadmins (clientId + teamkoppelingen).
         Cloud Functions lezen/schrijven hier via Admin SDK. */
      match /geheim/{id} {
        allow read, write: if isClubAdmin(clubId);
      }
      /* AI-verbruik per maand: alleen lezen voor admins, schrijven door functions */
      match /aiGebruik/{maand} {
        allow read: if isClubAdmin(clubId);
        allow write: if false;
      }
    }

    /* ======================= teams ======================= */
    match /teams/{teamId} {
      /* lezen: teamleden en leden van de club van het team (resource-gebaseerd, dus ook voor
         list-queries leden.<uid>==true en club==…). Aansluiten via teamcode loopt via de
         Cloud Function sluitAan; niet-leden kunnen teams dus niet meer opzoeken. */
      /* [20261011f] een niet-bestaand team lezen verraadt niets; zo laat één verwijderd team een
         'in'-query op club.teams niet meer falen (zwart clubscherm) */
      allow read: if (echt() && resource == null)
                  || isPlatform()      /* [20261020a] teamlijst per club voor het platformoverzicht; spelers e.d. alleen in de ondersteuningsmodus */
                  || (echt() && (resource.data.get('leden', {}).get(uid(), false) == true
                                 || (resource.data.get('club', null) != null && isClubLid(resource.data.club))
                                 || (resource.data.get('club', null) != null && isTraincoVanClub(resource.data.club))));
      /* [20261115d] de anonieme deel-link leest het teamdocument niet meer (namen van coaches, vaste afmeldingen) */
      /* [20261125w] sport: alleen een team zonder club kiest zelf (een clubteam volgt de club), en alleen een bekende sport */
      allow create: if echt()
        && (!('sport' in request.resource.data) || (request.resource.data.get('club', null) == null && geldigeSport(request.resource.data)))
        && (
        (request.resource.data.leden.get(uid(), false) == true
          && (request.resource.data.get('club', null) == null
              || isClubLid(request.resource.data.club) || isClubAdmin(request.resource.data.club)))
        /* [20261011d] clubbeheerder maakt teams aan zonder er zelf lid van te worden (Sportlink-import) */
        || (request.resource.data.get('club', null) != null && isClubAdmin(request.resource.data.club)));
      /* leden en clubkoppeling: een coach mag die niet zelf wijzigen (anders kan hij iemand toevoegen of het team
         naar een andere club verplaatsen). Clubbeheer en de coördinator van de bouw mogen wel. */
      /* [20261125w] de sport van een team ligt vast na het aanmaken (zie geldigeSport) */
      allow update: if sportGelijk() && ((isVolCoach(teamId) && coachWijzigtTeamVeilig())
        /* sturende rol: alles, maar het team gaat niet naar een andere club (loskoppelen mag alleen de clubadmin) */
        || (magBouwSturen(teamId)
            && (request.resource.data.get('club', null) == resource.data.get('club', null)
                || (request.resource.data.get('club', null) == null && isClubAdmin(teamClub(teamId))))));
      /* [20261115d] een clubteam verwijdert alleen de clubadmin; een trainer zonder club zijn eigen team */
      allow delete: if (isVolCoach(teamId) && resource.data.get('club', null) == null)
        || (resource.data.get('club', null) != null && isClubAdmin(resource.data.club));

      /* wildcard: dekt spelers, wedstrijden, presentie, beoordelingen, teamevaluaties,
         planning, poule, sjablonen, lijsten, trainingAantekeningen, … ook nieuwe. */
      /* [20261115d] LET OP: minstens één padsegment ({sub}/{rest=**}). Een kale {sub=**} past in rules-versie 2
         ook op het teamdocument zelf en zette daarmee de beperkingen van allow update hierboven buiten werking. */
      match /{sub}/{rest=**} {
        allow read, write: if magSchrijven(teamId);      /* teamleden, clubadmin, coördinator van de bouw */
      }
      /* assistent (en iedere coach): rooster en poule zijn niet gevoelig, alleen lezen */
      match /wedstrijden/{id} { allow read: if isTeamLid(teamId); }
      match /planning/{id}    { allow read: if isTeamLid(teamId); }
      match /poule/{id}       { allow read: if isTeamLid(teamId); }
      /* [20261115e] spelerdocumenten (met notitie en leerpunten van de coach): het eigen team leest en schrijft
         via de regel hierboven. Daarnaast lezen alleen de sturende rollen van de club (uitlenen, bouwoverzicht,
         evaluatierondes). Een coach van een ander team leest ze niet meer, en de anonieme deel-link ook niet:
         naam en rugnummer staan op de deel-link zelf. */
      match /spelers/{id} {
        allow read: if teamBestaat(teamId) && teamClub(teamId) != null && isSturendInClub(teamClub(teamId));
      }
      /* presentie: geen deel-link; alleen via de wildcard hierboven (teamleden, clubbeheer, coördinator) */
      /* poule/* wordt door Cloud Functions geschreven (Admin SDK); coaches lezen via de wildcard */
    }

    /* Club-inhoud: elk document draagt `club`; lezen/schrijven alleen voor leden van die club
       (de client queryt met where('club','==',…), zie teams.js clubChunks). Documenten zonder
       `club` (oude data) zijn alleen voor de platformbeheerder bereikbaar. */
    function clubInhoudLezen() { return isPlatform() || (echt() && resource.data.get('club', null) != null && isClubLid(resource.data.club)); }
    function traincoInhoudLezen() { return echt() && resource.data.get('club', null) != null && isTraincoVanClub(resource.data.club); }
    function clubInhoudNieuw() { return echt() && request.resource.data.get('club', null) != null && isClubLid(request.resource.data.club); }
    function clubInhoudBeheer() { return isPlatform() || (echt() && resource.data.get('club', null) != null && isClubAdmin(resource.data.club)); }
    function clubInhoudNieuwBeheer() { return echt() && request.resource.data.get('club', null) != null && isClubAdmin(request.resource.data.club); }
    function trainingClub(id) { return get(/databases/$(database)/documents/trainingen/$(id)).data.get('club', null); }
    /* trainingen schrijven: hoofd jeugdopleiding / clubadmin, of de coach van een training voor precies één team.
       Een training voor meerdere teams wijzigt alleen het hoofd jeugdopleiding of de clubadmin. */
    /* [20261115d] en de training hoort bij de club van dat team (anders kon een coach een training in een andere club plaatsen) */
    function isTrainingCoach(d) {
      return echt() && d.get('teams', []).size() == 1 && isVolCoach(d.get('teams', [])[0])
        && teamClub(d.get('teams', [])[0]) == d.get('club', null);
    }
    /* [20261111d] de bouwcoördinator wijst het seizoensplan van zijn bouw toe: hij mag trainingen voor precies
       één team uit zijn eigen bouw schrijven (zelfde club) */
    function isTrainingCoordinator(d) {
      return echt() && d.get('teams', []).size() == 1 && teamBestaat(d.get('teams', [])[0])
        && teamClub(d.get('teams', [])[0]) == d.get('club', null)
        && isCoordinatorVanBouw(d.get('club', null), team(d.get('teams', [])[0]).get('bouw', '_'));
    }
    function magTrainingSchrijven(d) { return d.get('club', null) != null && (isJeugdPlanner(d.get('club', null)) || isTrainingCoach(d) || isTrainingCoordinator(d)); }
    function trainingSchrijver(id) { return echt() && magTrainingSchrijven(get(/databases/$(database)/documents/trainingen/$(id)).data); }

    match /trainingen/{id} {
      allow read: if clubInhoudLezen() || traincoInhoudLezen()
        || (anoniem() && exists(/databases/$(database)/documents/trainingToegang/$(uid()))
            && get(/databases/$(database)/documents/trainingToegang/$(uid())).data.trainingId == id
            && get(/databases/$(database)/documents/trainingToegang/$(uid())).data.vervaltOp > request.time);
      allow create: if echt() && magTrainingSchrijven(request.resource.data);
      allow update: if echt() && magTrainingSchrijven(resource.data) && magTrainingSchrijven(request.resource.data);
      allow delete: if echt() && magTrainingSchrijven(resource.data);
      /* [20261115d] subcollecties: clubleden lezen alles; de trainingscoördinator leest de inhoud van de training,
         maar niet de samenvattingen van wat coaches erbij noteren (hotspotSamenvattingen) */
      match /{col}/{rest=**} {
        allow read: if echt() && trainingClub(id) != null
          && (isClubLid(trainingClub(id)) || (col != 'hotspotSamenvattingen' && isTraincoVanClub(trainingClub(id))));
        allow write: if trainingSchrijver(id);
      }
    }
    match /videos/{id} {
      allow read: if clubInhoudLezen() || traincoInhoudLezen();
      allow create: if clubInhoudNieuw();
      allow update, delete: if clubInhoudBeheer();
    }
    match /documenten/{id} {
      allow read: if clubInhoudLezen();
      allow create: if clubInhoudNieuwBeheer();
      allow update, delete: if clubInhoudBeheer();
    }
    match /berichten/{id} {
      allow read: if clubInhoudLezen();
      allow create: if clubInhoudNieuwBeheer();
      allow update, delete: if clubInhoudBeheer();
    }

    /* platform-brede leerinhoud (kaarten e.d.) */
    match /content/{id} {
      allow read: if echt();
      allow write: if isPlatform();
    }

    /* ======================= deel-links (ouders, anoniem) ======================= */
    match /trainingDeel/{id} {
      allow get: if ingelogd();
      allow list: if false;
      allow create: if echt() && request.resource.data.gemaaktDoor == uid() && magSchrijven(request.resource.data.teamId);
      allow update, delete: if echt() && resource.data.gemaaktDoor == uid();
    }
    match /trainingToegang/{u} {
      /* upsert door de anonieme gebruiker zelf, mits de deel-link bestaat, past en niet verlopen is */
      allow read: if ingelogd() && u == uid();
      allow create, update: if ingelogd() && u == uid()
        && exists(/databases/$(database)/documents/trainingDeel/$(request.resource.data.deelId))
        && get(/databases/$(database)/documents/trainingDeel/$(request.resource.data.deelId)).data.teamId == request.resource.data.teamId
        && get(/databases/$(database)/documents/trainingDeel/$(request.resource.data.deelId)).data.trainingId == request.resource.data.trainingId
        && get(/databases/$(database)/documents/trainingDeel/$(request.resource.data.deelId)).data.vervaltOp > request.time
        /* [20261011d] vervaldatum moet gelijk zijn aan die van de deel-link: anders kan een anonieme
           gebruiker zijn eigen toegang eindeloos verlengen */
        && request.resource.data.vervaltOp == get(/databases/$(database)/documents/trainingDeel/$(request.resource.data.deelId)).data.vervaltOp;
      allow delete: if ingelogd() && u == uid();
    }

    /* ======================= gebruikers & statistiek ======================= */
    /* ======================= onboarding & toegang ======================= */
    /* Alles hieronder wordt uitsluitend door Cloud Functions geschreven (Admin SDK). */
    match /uitnodigingen/{id} {
      allow read: if isPlatform()
        || (echt() && isClubAdmin(resource.data.clubId))
        || (echt() && resource.data.get('teamId', null) != null && isVolCoach(resource.data.teamId));
      allow write: if false;
    }
    match /aanvragen/{id} {
      allow read: if isPlatform() || echt() && (resource.data.uid == uid()
        || isClubAdmin(resource.data.clubId)
        || (resource.data.get('teamId', null) != null && isVolCoach(resource.data.teamId)));
      allow write: if false;
    }
    /* [20261020a] ondersteuningsmodus van de eindbaas: eigen document alleen lezen; schrijven via Cloud Function */
    match /ondersteuning/{u} {
      allow read: if echt() && u == uid();
      allow write: if false;
    }
    match /toegangslog/{id} {
      allow read: if isPlatform() || (echt() && isClubAdmin(resource.data.clubId));
      allow write: if false;
    }
    match /privacyKennisname/{u} {
      allow read: if echt() && u == uid();
      allow write: if false;
    }
    match /rateLimit/{id} {
      allow read, write: if false;
    }

    match /gebruikers/{u} {
      allow read, write: if echt() && u == uid();
      match /{sub=**} {
        allow read, write: if echt() && u == uid();
      }
    }
    /* logins: alleen uid + datum; niet leesbaar voor clients (alleen platformbeheerder / functions) */
    match /logins/{id} {
      allow create: if echt() && request.resource.data.uid == uid()
        && request.resource.data.keys().hasOnly(['uid', 'datum', 'tijd']);
      allow read, update, delete: if isPlatform();
    }
    /* gebruik + navpaden: schrijven door de eigenaar; lezen alleen door beheerders van de EIGEN club */
    match /gebruik/{id} {
      allow read: if isPlatform() || (echt() && resource.data.get('clubId', null) != null && isClubAdmin(resource.data.clubId));
      allow create, update: if echt() && id.matches(uid() + '_.*') && request.resource.data.uid == uid();
      allow delete: if isPlatform();
    }
    match /navpaden/{id} {
      allow read: if isPlatform() || (echt() && resource.data.get('clubId', null) != null && isClubAdmin(resource.data.clubId));
      allow create, update: if echt() && id.matches(uid() + '_.*') && request.resource.data.uid == uid();
      allow delete: if isPlatform();
    }
    match /gebruikstats/{clubId} {
      /* `lezers` (admins + bouwcoördinatoren) zet aggregeerGebruik zelf: rules kunnen niet over
         alle bouwen van bouwCoordinatoren itereren */
      allow read: if isClubAdmin(clubId) || isPlatform() || (echt() && uid() in resource.data.get('lezers', []));
      allow write: if false;            /* alleen aggregeerGebruik (Admin SDK) */
    }
    /* gepubliceerde clubsjablonen: elke ingelogde gebruiker leest, alleen de clubbeheerder van die club schrijft */
    match /sjablonen/{clubId} {
      allow read: if echt();
      allow create, update: if isClubAdmin(clubId) && request.resource.data.clubId == clubId;
      allow delete: if isClubAdmin(clubId) || isPlatform();
    }
    /* aanmeldingen van nieuwe clubs (publieke aanmeldpagina → Cloud Function meldClubAan) */
    match /clubAanmeldingen/{id} {
      allow read: if isPlatform() || (echt() && id == uid());
      allow write: if false;
    }
    /* leren van gebruik (functions/leren.js): ruwe signalen, tellers en het geheim zijn alleen voor Cloud Functions;
       de maandelijkse samenvatting leest alleen de platformbeheerder */
    match /leersignalen/{id} { allow read, write: if false; }
    match /leren_teller/{id} { allow read, write: if false; }
    match /leren_geheim/{id} { allow read, write: if false; }
    match /leerstatistiek/{id} {
      allow read: if isPlatform();
      allow write: if false;
    }
    /* uitgaande e-mail (Firebase-extensie Trigger Email); alleen Cloud Functions schrijven */
    match /mail/{id} {
      allow read, write: if false;
    }
    /* anonieme clubvergelijking: het overzicht (alleen mediaan/p75, geen clubnamen) leest iedereen,
       de eigen waarden alleen de clubbeheerder; schrijven doet alleen de Cloud Function */
    match /benchmark/{id} {
      allow read: if (id == 'overzicht' && echt()) || isClubAdmin(id) || isPlatform();
      allow write: if false;
    }
    /* ======================= teamkamer: ouders en spelers [20261116m] ======================= */
    /* Ouders en spelers staan NIET in teams.leden of clubs.leden: geen van de regels hierboven geldt voor hen.
       Zij lezen alleen de kopie onder teamkamer/{teamId}, die de Cloud Functions vullen met toegestane velden
       (functions/teamkamer-logica.js). Lidmaatschap (kamerleden) maken alleen de Cloud Functions: een ouder na
       goedkeuring door de coach, een speler met een code van de eigen ouder (anoniem account, geen e-mail).
       Coaches (magSchrijven) lezen alles van hun eigen team en schrijven mededelingen en polls. */
    function kamerLid(t) { return get(/databases/$(database)/documents/teamkamer/$(t)/kamerleden/$(uid())).data; }
    function kamerAan(t) {
      return exists(/databases/$(database)/documents/teamkamer/$(t))
        && get(/databases/$(database)/documents/teamkamer/$(t)).data.get('aan', false) == true;
    }
    /* wat de eindbaas voor deze club (of voor trainers zonder club) heeft aangezet; de Cloud Functions zetten het in de kopie (mag).
       Standaard staat elke mogelijkheid uit. */
    function kamerMag(t, k) {
      return kamerAan(t) && get(/databases/$(database)/documents/teamkamer/$(t)).data.get('mag', {}).get(k, false) == true;
    }
    /* een speler (code van de ouder) telt alleen als lid zolang de eindbaas toegang voor spelers aan heeft */
    function isKamerLid(t) {
      return ingelogd() && exists(/databases/$(database)/documents/teamkamer/$(t)/kamerleden/$(uid())) && kamerLid(t).vervaltOp > request.time
        && (kamerLid(t).get('rol', '') != 'speler' || kamerMag(t, 'spelers'));
    }
    function kamerLezen(t) { return (isKamerLid(t) && kamerAan(t)) || magSchrijven(t); }
    function kamerEigenSpeler(t, s) { return isKamerLid(t) && s in kamerLid(t).get('spelerIds', []); }
    function pollDoc(t, p) { return get(/databases/$(database)/documents/teamkamer/$(t)/polls/$(p)).data; }
    function pollOpen(t, p) {
      return pollDoc(t, p).get('status', '') == 'open'
        && (pollDoc(t, p).get('sluitOp', null) == null || pollDoc(t, p).sluitOp > request.time);
    }
    match /teamkamer/{teamId} {
      allow read: if kamerLezen(teamId);
      allow write: if false;                       /* alleen Cloud Functions */
      match /agenda/{id} {
        allow read: if kamerLezen(teamId);
        allow write: if false;
      }
      /* alleen het eigen gezin (voornaam, rugnummer, beurten) en de coach */
      match /gezin/{spelerId} {
        allow read: if (kamerEigenSpeler(teamId, spelerId) && kamerAan(teamId)) || magSchrijven(teamId);
        allow write: if false;
        /* [20261116r] cijfers van het eigen kind: alleen de ouders, niet de speler zelf (die komt binnen met een code) */
        match /ouder/{docId} {
          allow read: if (kamerEigenSpeler(teamId, spelerId) && kamerAan(teamId) && kamerLid(teamId).get('rol', '') == 'ouder') || magSchrijven(teamId);
          allow write: if false;
        }
      }
      match /kamerleden/{lidUid} {
        allow read: if (ingelogd() && lidUid == uid()) || magSchrijven(teamId);
        allow write: if false;
      }
      match /berichten/{id} {
        allow read: if kamerLezen(teamId);
        allow create, update: if magSchrijven(teamId) && kamerMag(teamId, 'berichten');
        allow delete: if magSchrijven(teamId);
      }
      match /polls/{pollId} {
        allow read: if kamerLezen(teamId);
        allow create, update: if magSchrijven(teamId) && kamerMag(teamId, 'polls');
        allow delete: if magSchrijven(teamId);
        /* één document per speler = één stem per gezin. Een gezin leest en schrijft alleen de eigen stem,
           alleen zolang de poll open is, en een speler alleen als de coach dat voor deze poll toestaat.
           Tellen doet de Cloud Function kamerStem; wie wat koos staat alleen in de poll als de coach dat aanzet. */
        match /stemmen/{spelerId} {
          allow read: if kamerEigenSpeler(teamId, spelerId) || magSchrijven(teamId);
          allow create, update: if kamerEigenSpeler(teamId, spelerId) && kamerMag(teamId, 'polls') && pollOpen(teamId, pollId)
            && (pollDoc(teamId, pollId).get('spelers', false) == true || kamerLid(teamId).get('rol', '') == 'ouder')
            && request.resource.data.keys().hasOnly(['keuzes', 'door', 'ms'])
            && request.resource.data.door == uid()
            && request.resource.data.keuzes is list && request.resource.data.keuzes.size() <= 12;
          allow delete: if magSchrijven(teamId);
        }
      }
    }
    /* aanvraag van een ouder: zelf lezen, de coach van het team leest ook; schrijven via Cloud Functions */
    match /kamerAanvragen/{id} {
      allow read: if echt() && (resource.data.uid == uid() || magSchrijven(resource.data.teamId));
      allow write: if false;
    }
    /* teamlinks en kindcodes: alleen Cloud Functions */
    match /kamerLinks/{id} { allow read, write: if false; }
    match /kindCodes/{id} { allow read, write: if false; }

    /* ======================= trainingshulp (Lijstjes) [20261118a] ======================= */
    /* Ouders schrijven zich in als helper bij een training. De trainer maakt de lijst in Lijstjes
       (public/js/lijst-hulp.js) en kiest per lijst hoe ouders erbij komen:
       - kamer == true: ouders en spelers met toegang tot de teamkamer van dat team, mits de eindbaas
         Trainingshulp voor de teamkamer heeft aangezet (teamkamer/{teamId}.mag.hulp, standaard uit).
         Alleen een ouder schrijft zich in; een speler leest mee.
       - open == true: iedereen met de link (?hulp=<id>), ook anoniem. De collectie doorzoeken kan zo
         iemand niet: alleen 'get' op het document, je moet het id hebben.
       Top-level, zodat een ouder niets onder teams/{teamId} hoeft te lezen. In het document staan
       trainingsdata en aantallen; in de aanmeldingen alleen een voornaam. De staf is dezelfde kring
       als bij de lijstjes zelf (magSchrijven). */
    function hulpViaKamer(d) {
      return d.get('kamer', false) == true && isKamerLid(d.teamId) && kamerMag(d.teamId, 'hulp');
    }
    match /hulpDeel/{deelId} {
      allow get: if ingelogd() && (resource.data.get('open', false) == true || hulpViaKamer(resource.data) || magSchrijven(resource.data.teamId));
      /* de teamkamer zoekt de lijsten van het eigen team op: where teamId == … en kamer == true */
      allow list: if ingelogd() && hulpViaKamer(resource.data);
      allow create: if echt() && request.resource.data.teamId is string && magSchrijven(request.resource.data.teamId)
        && request.resource.data.get('club', null) == teamClub(request.resource.data.teamId);
      /* aantal helpers, trainingen, kamer en link aan of uit: alleen de staf; team en club liggen vast */
      allow update: if magSchrijven(resource.data.teamId)
        && request.resource.data.teamId == resource.data.teamId
        && request.resource.data.get('club', null) == resource.data.get('club', null);
      allow delete: if magSchrijven(resource.data.teamId);

      match /aanmeldingen/{aanmId} {
        function deel() { return get(/databases/$(database)/documents/hulpDeel/$(deelId)).data; }
        function staf() { return magSchrijven(deel().teamId); }
        allow read: if ingelogd() && (deel().get('open', false) == true || hulpViaKamer(deel()) || staf());
        /* Aanmaken: alleen de vijf bekende velden, op eigen uid, een voornaam van hooguit 24 tekens, bij een
           training die in de lijst staat.
           - ouder (open link): alleen als de link aan staat, onder het vaste id <uid>_<rij>;
           - kamer: een ouder met toegang tot de teamkamer (geen speler), onder hetzelfde vaste id;
           - coach: de staf van het team.
           Dat een training vol is, controleert de app en niet deze regel: twee ouders die tegelijk de laatste
           plek nemen, staan er allebei. De trainer haalt er dan één weg. */
        allow create: if ingelogd()
          && request.resource.data.keys().hasOnly(['uid', 'rij', 'naam', 'ms', 'door'])
          && request.resource.data.uid == uid()
          && request.resource.data.naam is string && request.resource.data.naam.size() > 0 && request.resource.data.naam.size() <= 24
          && request.resource.data.ms is number
          && request.resource.data.rij is string && request.resource.data.rij in deel().momenten
          && (
            (request.resource.data.door == 'ouder' && deel().get('open', false) == true && aanmId == uid() + '_' + request.resource.data.rij)
            || (request.resource.data.door == 'kamer' && hulpViaKamer(deel()) && kamerLid(deel().teamId).get('rol', '') == 'ouder'
                && aanmId == uid() + '_' + request.resource.data.rij)
            || (request.resource.data.door == 'coach' && staf())
          );
        allow update: if false;
        /* weghalen: de eigen aanmelding, of de staf elke aanmelding */
        allow delete: if ingelogd() && (resource.data.uid == uid() || staf());
      }
    }
    /* [20261125x] Activiteiten: vrijwilligersdiensten met een open link (?act=<id>, activiteit-boot.js).
       Zelfde opzet als hulpDeel: wie de link heeft (ook anoniem) leest de diensten en voornamen en maakt per
       dienst één eigen aanmelding. Het comité van de activiteit beheert alles. Geen kinderen, geen telefoonnummers. */
    /* [20261125n] Live pagina van een toernooi (Activiteiten › Toernooi › Live): schema, uitslagen, stand en mededelingen
       voor iedereen met de link of QR-code (anoniem ingelogd, ?live=<id>). Geen spelersnamen. Niet op te sommen;
       schrijven alleen het comité van die activiteit. */
    match /toernooiLive/{liveId} {
      function liveBeheer(d) { return d.get('club', null) is string && d.get('actId', null) is string && magActiviteit(d.club, d.actId); }
      allow get: if ingelogd() && (resource.data.get('open', false) == true || liveBeheer(resource.data));
      allow list: if false;
      allow create: if echt() && liveBeheer(request.resource.data)
        && request.resource.data.get('schema', []) is list && request.resource.data.get('schema', []).size() <= 900;
      allow update: if echt() && liveBeheer(resource.data)
        && request.resource.data.get('club', null) == resource.data.get('club', null)
        && request.resource.data.get('actId', null) == resource.data.get('actId', null)
        && request.resource.data.get('schema', []) is list && request.resource.data.get('schema', []).size() <= 900;
      allow delete: if echt() && liveBeheer(resource.data);
    }
    match /activiteitDeel/{deelId} {
      function actBeheer(d) { return d.get('club', null) is string && d.get('actId', null) is string && magActiviteit(d.club, d.actId); }
      allow get: if ingelogd() && (resource.data.get('open', false) == true || actBeheer(resource.data));
      allow list: if false;
      allow create: if echt() && actBeheer(request.resource.data) && request.resource.data.diensten is map && request.resource.data.diensten.size() <= 60;
      allow update: if echt() && actBeheer(resource.data)
        && request.resource.data.get('club', null) == resource.data.get('club', null)
        && request.resource.data.get('actId', null) == resource.data.get('actId', null)
        && request.resource.data.diensten is map && request.resource.data.diensten.size() <= 60;
      allow delete: if echt() && actBeheer(resource.data);

      match /aanmeldingen/{aanmId} {
        function deel() { return get(/databases/$(database)/documents/activiteitDeel/$(deelId)).data; }
        function beheer() { return echt() && actBeheer(deel()); }
        allow read: if ingelogd() && (deel().get('open', false) == true || beheer());
        /* aanmaken: alleen de vijf velden, op eigen uid, een voornaam van hooguit 24 tekens, bij een bestaande dienst.
           - via de link: alleen als die open staat, onder het vaste id <uid>_<dienst> (één keer per dienst per toestel);
           - het comité: met een automatisch id. Vol of niet controleert de app. */
        allow create: if ingelogd()
          && request.resource.data.keys().hasOnly(['uid', 'dienst', 'naam', 'ms', 'door'])
          && request.resource.data.uid == uid()
          && request.resource.data.naam is string && request.resource.data.naam.size() > 0 && request.resource.data.naam.size() <= 24
          && request.resource.data.ms is number
          && request.resource.data.dienst is string && request.resource.data.dienst in deel().diensten
          && ((request.resource.data.door == 'link' && deel().get('open', false) == true && aanmId == uid() + '_' + request.resource.data.dienst)
              || (request.resource.data.door == 'comite' && beheer()));
        /* op de dag: het comité vinkt aan wie er is (alleen dat veld) */
        allow update: if beheer() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aanwezig']) && request.resource.data.aanwezig is bool;
        allow delete: if ingelogd() && (resource.data.uid == uid() || beheer());
      }
    }
    /* clubprofiel: wat de platformbeheerder uit de documenten van een club heeft gehaald
       (platform-clubprofiel.js). Bewust buiten clubs/{id}: de club zelf leest dit nog niet. */
    match /clubprofielen/{clubId} {
      allow read, write: if isPlatform();
    }
    /* platformcijfers per club (platformdashboard): alleen de platformbeheerder */
    match /platformstats/{id} {
      allow read: if isPlatform();
      allow write: if false;
    }
  }
}
