{
  "name": "cluppie",
  "version": "2.0.0",
  "description": "Multi-tenant coachplatform voor jeugdvoetbal (PWA + Firebase)",
  "private": true,
  "scripts": {
    "serve": "firebase serve --only hosting",
    "emulate": "firebase emulators:start",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy:functions": "echo 'Gebruik: firebase deploy --only functions:<naam>,…' && exit 1",
    "test:rules": "firebase emulators:exec --only firestore --project cluppie-rules-test \"node --test tests/rules.test.mjs\"",
    "test": "node tests/sleutel.test.mjs && node tests/gebruik.test.mjs"
  },
  "author": "Paul Lijten",
  "license": "MIT",
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.14.1",
    "firebase-tools": "^13.0.0"
  }
}
